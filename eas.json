{
    "cli": {
        "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_GRAPHQL_URL": "https://newapi.mordovklimat.ru/graphql",
        "EXPO_PUBLIC_API_URL": "https://newapi.mordovklimat.ru"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_GRAPHQL_URL": "https://newapi.mordovklimat.ru/graphql",
        "EXPO_PUBLIC_API_URL": "https://newapi.mordovklimat.ru"
      }
    }
  }
}